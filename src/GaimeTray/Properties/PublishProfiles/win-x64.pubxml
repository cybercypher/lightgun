<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build: one self-contained GaimeTray.exe (no .NET install needed) plus
  reshade\ and, when built, gun_bridge.uf2 beside it, zipped as
  artifacts\GaimeTray-win-x64.zip.

    dotnet publish src\GaimeTray\GaimeTray.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\GaimeTray-win-x64\</PublishDir>
    <ZipRelease>true</ZipRelease>
  </PropertyGroup>
</Project>
