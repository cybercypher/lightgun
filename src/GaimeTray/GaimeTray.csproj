<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GaimeTray</AssemblyName>
    <RootNamespace>GaimeTray</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <!-- Engine files live in ..\GaimeFeeder (no project there; the console
         app was removed). Orchestration lives in FeederEngine.cs. -->
    <Compile Include="..\GaimeFeeder\AppPaths.cs" Link="Engine\AppPaths.cs" />
    <Compile Include="..\GaimeFeeder\GunState.cs" Link="Engine\GunState.cs" />
    <Compile Include="..\GaimeFeeder\GunMap.cs" Link="Engine\GunMap.cs" />
    <Compile Include="..\GaimeFeeder\RectCalib.cs" Link="Engine\RectCalib.cs" />
    <Compile Include="..\GaimeFeeder\PicoOutput.cs" Link="Engine\PicoOutput.cs" />
    <Compile Include="..\GaimeFeeder\FeedCore.cs" Link="Engine\FeedCore.cs" />
    <Compile Include="..\GaimeFeeder\HidIdentity.cs" Link="Engine\HidIdentity.cs" />
    <Compile Include="..\GaimeFeeder\GunBoxCal.cs" Link="Engine\GunBoxCal.cs" />
    <Compile Include="..\GaimeFeeder\RawInput.cs" Link="Engine\RawInput.cs" />
    <Compile Include="..\GaimeFeeder\ScreenBorder.cs" Link="Engine\ScreenBorder.cs" />
    <Compile Include="..\GaimeFeeder\CalibrationWindow.cs" Link="Engine\CalibrationWindow.cs" />
    <Compile Include="..\GaimeFeeder\SnWriterForm.cs" Link="Engine\SnWriterForm.cs" />
    <Compile Include="..\GaimeFeeder\SetupConfig.cs" Link="Engine\SetupConfig.cs" />
    <Compile Include="..\GaimeFeeder\BridgeDevices.cs" Link="Engine\BridgeDevices.cs" />
    <Compile Include="..\GaimeFeeder\CalStatus.cs" Link="Engine\CalStatus.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- White border shader + preset for the setup wizard's ReShade install. -->
    <Content Include="..\..\tools\reshade\*" Link="reshade\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
